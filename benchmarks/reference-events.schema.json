{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abg-pulse.local/schemas/reference-events.schema.json",
  "title": "ABG Pulse independent daily reference events",
  "type": "object",
  "required": ["date", "assembledIndependently", "events"],
  "properties": {
    "date": { "type": "string", "format": "date" },
    "assembledIndependently": { "const": true },
    "method": { "type": "string", "minLength": 10 },
    "reviewer": { "type": ["string", "null"] },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "materiality", "sources"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "title": { "type": "string", "minLength": 8 },
          "materiality": { "enum": ["critical", "high", "medium", "low"] },
          "critical": { "type": "boolean" },
          "weight": { "type": "number", "minimum": 0 },
          "entities": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "occurredAt": { "type": ["string", "null"], "format": "date-time" },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["url", "tier"],
              "properties": {
                "url": { "type": "string", "format": "uri" },
                "tier": { "enum": ["tier0", "tier1", "tier2", "tier3"] },
                "publisher": { "type": ["string", "null"] },
                "publishedAt": { "type": ["string", "null"], "format": "date-time" }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
