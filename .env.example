# Server-side only. Never expose these to browser JavaScript.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
INGEST_SECRET=replace-with-a-long-random-secret

# Optional authorised/licensed public-conversation integration.
SOCIAL_LISTENING_PROVIDER=
SOCIAL_INGEST_SECRET=replace-with-a-separate-long-random-secret
SOCIAL_LISTENING_EXPORT_URL=
SOCIAL_LISTENING_ACCESS_TOKEN=

# Vercel Cron authenticates scheduled ingestion with this bearer secret.
CRON_SECRET=replace-with-a-separate-long-random-secret
